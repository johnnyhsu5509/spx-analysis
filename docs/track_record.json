  "scoring_rules": {
    "actual": "次一交易日收盤漲跌%：≥+0.3%=up、≤-0.3%=down、其間=flat",
    "bias_mapping": "偏多/中性偏多→預期up；偏空/中性偏空→預期down；中性→預期flat",
