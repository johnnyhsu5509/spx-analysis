{
  "purpose": "累積戰績帳本：終結『自己出題自己改』的單日命中率灌水，用機械化計分看系統真實 edge。每日分析後必須追加一筆並重算 summary。",
  "scoring_rules": {
    "actual": "次一交易日收盤漲跌%：≥+0.3%=up、≤-0.3%=down、其間=flat",
    "bias_mapping": "偏多/中性偏多→預期up；偏空/中性偏空→預期down；中性→預期flat",
    "grade": "方向對=hit(1分)、方向錯=miss(0分)、其餘(偏向遇flat或中性遇方向)=half(0.5分)",
    "note": "『正確未觸發』的策略單另計、不算hit；此表只計方向判斷。滾動勝率=總分/已判定筆數"
  },
  "brier_rules": {
    "purpose": "追蹤拉回機率的『機率報得準不準』，不只方向對錯。目標：逼系統敢報極端值、終結45-64窄帶躺平（2026-07-07啟用）",
    "formula": "brier = (p - outcome)²，p = pullback_prob/100，outcome：down=1、up=0、flat排除不計",
    "caveat": "pullback_prob名義上是5D拉回機率，但此處按每日迴圈的實際用法對『次日方向』計分；flat日排除會縮小樣本，解讀時注意",
    "benchmark": "永遠報50%的無腦基準=0.25。低於0.25才代表機率有資訊量；越低越好",
    "discrimination_note": "同時觀察報價分布：若機率永遠在45-64窄帶，即使brier達標也視為鑑別度不足"
  },
